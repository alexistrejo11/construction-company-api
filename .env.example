# Copy this file to `.env` and fill in your values.
# Used by: Spring Boot (via config.import), Gradle bootRun, and docker compose.

# Application
SPRING_APPLICATION_NAME=company-expenses-api

# Database (PostgreSQL)
# Local Gradle bootRun: use DB_PORT=5432 when connecting to a local PostgreSQL instance.
DB_NAME=company_expenses
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_PORT=5432
DB_HOST=localhost

# Docker Compose overrides DB_HOST and DB_PORT to connect the app to its db service.

# JWT
# Base64-encoded secret key for HMAC-SHA256 (must decode to a valid key length).
JWT_SECRET_KEY=your-base64-encoded-secret-key
# Optional — defaults to 86400000 (24 hours)
JWT_EXPIRATION_MS=86400000

# File uploads
FILE_UPLOAD_DIR=./uploads

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_PROTOCOL=smtp
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
